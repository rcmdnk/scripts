#!/usr/bin/env bash

# Rewrite author/committer whose name or email contains <fix_word>.
# Push manually after checking the result.

if [ "$#" -lt 3 ];then
  echo "usage: $0 <fix_word> <correct_name> <correct_email>" >&2
  exit 1
fi
export FIX_WORD="$1"
export CORRECT_NAME="$2"
export CORRECT_EMAIL="$3"

if ! git log --branches --tags --pretty=format:"%an %ae %cn %ce" | grep -qiF -- "$FIX_WORD";then
  echo "No commit matches $FIX_WORD."
  exit 0
fi

# Values are passed by environment variables to avoid quoting problems.
# shellcheck disable=SC2016
FILTER_BRANCH_SQUELCH_WARNING=1 git filter-branch -f --env-filter '
if printf "%s\n%s\n" "$GIT_COMMITTER_NAME" "$GIT_COMMITTER_EMAIL" | grep -qiF -- "$FIX_WORD";then
  export GIT_COMMITTER_NAME="$CORRECT_NAME"
  export GIT_COMMITTER_EMAIL="$CORRECT_EMAIL"
fi
if printf "%s\n%s\n" "$GIT_AUTHOR_NAME" "$GIT_AUTHOR_EMAIL" | grep -qiF -- "$FIX_WORD";then
  export GIT_AUTHOR_NAME="$CORRECT_NAME"
  export GIT_AUTHOR_EMAIL="$CORRECT_EMAIL"
fi
' --tag-name-filter cat -- --branches --tags || exit 1

echo
echo "History was rewritten. Check it, then push with:"
echo "  git push --force-with-lease --all"
echo "  git push --force --tags  # tags have no lease info, overwritten as is"

# @ Other place already cloned:
#git pull --allow-unrelated-histories
