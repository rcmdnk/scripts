#!/usr/bin/env bash

alg=256
if [ "$1" = "-a" ];then
  shift
  alg=$1
  shift
fi

if [ $# -eq 0 ];then
  echo "usage: $0 [-a <alg (default=256)>] file [file2 [file3...]]"
  exit
fi

d=$(mktemp -d)
trap 'rm -rf $d' HUP INT QUIT ABRT SEGV TERM EXIT
for f in "$@";do
  if [[ "$f" =~ ^https?:// ]];then
    name=$(basename "$f")
    log=$(curl -fsSkL -o "$d/$name" "$f" 2>&1)
    ret=$?
    if [ $ret -ne 0 ];then
      echo "failed: curl -fsSkL $f"
      echo ""
      echo "$log"
      exit $ret
    fi
    (cd "$d" && shasum -a "$alg" "$name")
  else
    shasum -a "$alg" "$f"
  fi
done
