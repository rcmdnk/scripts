#!/usr/bin/env bash

# decompression

if [[ $# -eq 0 ]];then
  echo "Usage: dec <file> [<file>...]" >&2
  exit 1
fi

ret=0
for file in "$@";do
  if [[ ! -f "$file" ]];then
    echo "$file does not exist." >&2
    ret=1
    continue
  fi
  # Avoid file names being parsed as options
  if [[ "$file" == -* ]];then
    file="./$file"
  fi
  case "$file" in
    *.tar|*.tar.gz|*.tgz|*.tar.bz2|*.tbz|*.tbz2|*.tar.xz|*.txz|*.tar.Z|*.tar.zst|*.tzst)
      # tar detects the compression format automatically
      tar xf "$file" ;;
    *.gz)
      gzip -d "$file" ;;
    *.bz2)
      bzip2 -d "$file" ;;
    *.xz)
      xz -d "$file" ;;
    *.zst)
      zstd -d --rm "$file" ;;
    *.Z)
      uncompress "$file" ;;
    *.zip)
      unzip "$file" ;;
    *.7z)
      7z x "$file" ;;
    *)
      echo "$file is not supported." >&2
      false ;;
  esac || ret=1
done
exit $ret
