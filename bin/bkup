#!/usr/bin/env bash

# Back up origDir to bkupDir.
# - Symbolic links are linked from bkupDir if not exist in bkupDir.
# - Files larger than 1000 KB are replaced by empty placeholder files.
# - Other files are copied only if they are newer than the backup.

if [ $# -ne 2 ];then
  echo "usage: bkup origDir bkupDir"
  exit
fi

if [ ! -d "$1" ];then
  echo "$1 is not a directory" >&2
  exit 1
fi

checkdir() {
  local src
  local dst
  local size
  for src in "${1}"/* "${1}"/.*;do
    case "${src##*/}" in
      .|..) continue;;
    esac
    # Skip unmatched glob patterns
    if [ ! -e "$src" ] && [ ! -L "$src" ];then
      continue
    fi
    dst="${2}/${src##*/}"
    if [ -L "$src" ];then
      if [ ! -e "$dst" ] && [ ! -L "$dst" ];then
        ln -s "$src" "$dst"
      fi
    elif [ -d "$src" ];then
      mkdir -p "$dst"
      checkdir "$src" "$dst"
    elif [ ! -f "$src" ];then
      echo "skip non-regular file: $src" >&2
    else
      size=$(du -ks "$src" | awk '{print $1}')
      if [ "$size" -gt 1000 ];then
        if [ ! -e "$dst" ];then
          touch "$dst"
        fi
      elif [ ! -e "$dst" ] || [ "$src" -nt "$dst" ];then
        cp -a "$src" "$dst"
      fi
    fi
  done
}

created=0
if [ ! -d "$2" ];then
  mkdir -p "$2" || exit 1
  created=1
fi
orig=$(cd "$1" && pwd -P)
bkup=$(cd "$2" && pwd -P)
case "$bkup/" in
  "$orig/"*)
    echo "bkupDir must not be inside origDir" >&2
    if [ "$created" -eq 1 ];then
      rmdir "$2"
    fi
    exit 1
    ;;
esac

checkdir "$orig" "$bkup"
