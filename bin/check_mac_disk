#!/usr/bin/env bash
set -euo pipefail

system_usage=$(/usr/sbin/system_profiler SPStorageDataType | awk 'function save(mp,cap,free){if(mp=="/System/Volumes/Data"){sel=mp;C=cap;F=free}else if(mp=="/"&&sel==""){sel=mp;C=cap;F=free}} function bytes(l){sub(/.*\(/,"",l);sub(/ bytes.*/,"",l);gsub(/,/,"",l);return l} $1=="Free:"{free=bytes($0)} $1=="Capacity:"{cap=bytes($0)} $1=="Mount"&&$2=="Point:"{save($3,cap,free);cap=free=""} END{used=C-F;gib=1024*1024*1024;printf "Used: %.1f / %.1f GiB (%.1f%%), Free: %.1f GiB [%s]\n",used/gib,C/gib,used/C*100,F/gib,sel}')
usage_percent=$(echo "$system_usage" | awk -F'[()%]' '{print $2}')
threshold=${1:-80}
if ! awk -v u="$usage_percent" -v t="$threshold" 'BEGIN{exit !(u > t)}'; then
  exit 0
fi
echo "Warning: System storage usage is at $usage_percent%."
echo "$system_usage"

# Show directories using 10 GB or more.
# du fails on permission denied entries, which is expected here.
{ du -s -g /* ~/.* 2>/dev/null || true; } | sort -nr | awk '$1 >= 10 {
  s = $1
  sub(/^[0-9]+[ \t]+/, "")
  print $0 ": " s " GB"
}'
