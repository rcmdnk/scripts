#!/usr/bin/env bash

# Compression

remove=0
HELP="
usage: comp [-r] directory_name [package_name]

       -r for remove original directory
       if package_name is not given, it makes file:
       directory_name.tar.gz"

while getopts rdh OPT;do
  case $OPT in
    r|d ) remove=1 ;;
    h ) echo "$HELP"; exit 0 ;;
    \? ) echo "$HELP" >&2; exit 1 ;;
  esac
done
shift $((OPTIND - 1))

if [[ $# -lt 1 ]] || [[ $# -gt 2 ]];then
  echo "$HELP" >&2
  exit 1
fi

# Remove trailing slashes
dir=$1
while [[ "$dir" == */ ]] && [[ "$dir" != / ]];do
  dir=${dir%/}
done
case "$dir" in
  /|.|..|*/.|*/..)
    echo "Cannot compress $1" >&2
    exit 1
    ;;
esac
if [[ ! -d "$dir" ]];then
  echo "$1 is not a directory" >&2
  exit 1
fi

package=${2:-${dir}.tar.gz}
echo "${package}"
tar czf "${package}" "${dir}" || exit 1

if [[ $remove -eq 1 ]];then
  rm -rf "${dir}"
fi
