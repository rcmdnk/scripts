#!/usr/bin/env bash
if [ $# -ne 1 ];then
  echo "enter one tex file name" >&2
  echo "(enter \"name\" for file \"name.tex\")" >&2
  exit 1
fi
name=${1%.tex}
if [ ! -f "$name.tex" ];then
  echo "$name.tex does not exist." >&2
  exit 1
fi

if type latexmk >&/dev/null;then
  latexmk -pdf -shell-escape "$name.tex"
elif type pdflatex >&/dev/null;then
  pdflatex --shell-escape "$name".tex
  if grep -q '\\bibdata' "$name.aux" 2>/dev/null;then
    bibtex "$name"
  fi
  pdflatex --shell-escape "$name".tex
  pdflatex --shell-escape "$name".tex
else
  rm -f "$name"{.aux,.bbl,.blg}
  platex --shell-escape "$name"
  if grep -q '\\bibdata' "$name.aux" 2>/dev/null;then
    bibtex "$name"
  fi
  platex --shell-escape "$name"
  platex --shell-escape "$name"
  dvipdfmx "$name".dvi
  rm -f "$name"{.dvi,.log,.aux,.ps,.bbl,.blg}
fi
