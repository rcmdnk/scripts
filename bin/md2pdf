#!/usr/bin/env bash

if ! type pandoc >& /dev/null;then
  echo "Please install pandoc" >&2
  exit 1
fi

usage="usage: md2pdf [-s (make slides)] [-t <theme>] [<output.pdf>] <input.md>"
if [ $# -eq 0 ];then
  echo "$usage" >&2
  exit 1
fi
input=""
output=""
format="latex"
opts=()

while getopts st:h OPT;do
  case $OPT in
    s ) format=beamer;;
    t ) opts+=(-V "theme:$OPTARG");;
    h ) echo "$usage";exit 0;;
    \? ) echo "$usage" >&2; exit 1;;
  esac
done
shift $((OPTIND - 1))

for v in "$@";do
  if [[ "$v" == *.md ]];then
    input=$v
  elif [[ "$v" == *.pdf ]];then
    output=$v
  else
    echo "$usage" >&2
    exit 1
  fi
done

if [ -z "$input" ];then
  echo "$usage" >&2
  exit 1
fi

output=${output:-${input%.md}.pdf}
pandoc -f markdown -t "$format" "${opts[@]}" -o "$output" "$input"
